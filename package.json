{
  "name": "fleet-bearings-api",
  "version": "1.0.0",
  "private": true,
  "description": "JSON API for the Fleet Bearings view, described by an OpenAPI 3.1 spec.",
  "type": "module",
  "scripts": {
    "check": "node scripts/check.ts",
    "fmt": "oxfmt",
