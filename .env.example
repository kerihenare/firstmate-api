# Fleet Bearings API settings. Copy to .env.local (not committed) and uncomment what you need.
# `pnpm start` and `./start.sh` both read .env.local; variables already set in the
# environment win. Blank values count as unset. A bad value stops the server at startup.

# The Firstmate home to read. Default: two folders above this repo.
# FM_HOME=/path/to/firstmate-home

# Interface and port to listen on.
# BEARINGS_API_HOST=127.0.0.1
# BEARINGS_API_PORT=4748

# When set, /api/v1/* needs `Authorization: Bearer <key>`.
# BEARINGS_API_KEY=

# Comma-separated host names the server answers to (and accepts as write Origins).
# BEARINGS_API_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Seconds between snapshot rebuilds, from 10 to 86400.
# BEARINGS_API_REFRESH=300

# Ticket links. Tasks get one only when both are set. Teams are letters and digits.
# BEARINGS_LINEAR_BASE=https://linear.app/<workspace>/issue/
# BEARINGS_LINEAR_TEAMS=LIV,ENG

# Commands to run, as names on PATH or absolute paths.
# BEARINGS_GH_BIN=gh
# BEARINGS_GIT_BIN=git
# BEARINGS_NO_MISTAKES_BIN=no-mistakes

# start.sh only: the node binary, and where the pid and log files go.
# BEARINGS_API_NODE=node
# BEARINGS_API_PID_FILE=./server.pid
# BEARINGS_API_LOG_FILE=./server.log
